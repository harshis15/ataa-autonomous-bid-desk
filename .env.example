# Copy to .env in this directory. Never use a VITE_ prefix for secrets.
# Demo mode works with these values empty.
AZURE_OPENAI_API_KEY=
# Resource endpoint, NOT the AI Foundry project URL. Root or /openai/v1 accepted.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# Your DEPLOYMENT name (not necessarily the underlying model name).
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
# Choose a chat model supporting JSON object output.
AZURE_MAX_COMPLETION_TOKENS=12000
AZURE_TIMEOUT_MS=120000
ENABLE_LIVE_AI=false
PORT=3001
# Local-only by default. See README before hosting live endpoints.
HOST=127.0.0.1

# Optional persistent directory. Default: runtime/ beside package.json.
# Use an absolute path to keep data when replacing/upgrading the app folder.
# Contains the SQLite database and the objects/ RFQ + report file store.
# ATAA_DATA_DIR=/absolute/path/to/ataa-data
